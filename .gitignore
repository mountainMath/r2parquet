# Claude Code: keep the project instructions, ignore local session state.
# CLAUDE.md lives here rather than at the top level so pkgdown does not pick
# it up as a page alongside README.md.
.claude/*
!.claude/CLAUDE.md
!.claude/review-*.md

# Output of knitting a vignette source in place, precompute.R knits into vignettes/
vignettes.orig/*.png
vignettes.orig/*.html
vignettes.orig/*.md
vignettes.orig/*_files/
